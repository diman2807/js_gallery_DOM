"use strict";
var mainPicture = document.querySelector("#largeImg");
var ul = document.querySelector("#thumbs");
if (ul) ul.addEventListener("click", function(evnt) {
    var thumbnail = evnt.target.closest("a");
    if (!thumbnail) return;
    evnt.preventDefault();
    if (mainPicture) mainPicture.src = thumbnail.getAttribute("href");
});

